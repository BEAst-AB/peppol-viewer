          </Field>
        </Table>
        <Table foreach="/*:Invoice/cac:InvoiceLine" title="Invoice lines" hasRowDetail="true">
          <Field>
            <Name>Line ID</Name>
            <Expr>cbc:ID/text()</Expr>
          </Field>
          <Field>
            <Name>Item</Name>
            <Expr>cac:Item/cbc:Name/text()</Expr>
