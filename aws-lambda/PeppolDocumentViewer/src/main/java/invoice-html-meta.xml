          <Field>
            <Name>Line amount</Name>
            <DisplayBlock format="singleLine">
              <Expr>cbc:LineExtensionAmount/text()</Expr>
              <Expr as="text">cbc:LineExtensionAmount/@currencyID</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Price</Name>
            <DisplayBlock format="singleLine">
              <Expr>cac:Price/cbc:PriceAmount/text()</Expr>
