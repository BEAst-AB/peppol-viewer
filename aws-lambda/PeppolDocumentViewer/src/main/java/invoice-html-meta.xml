                </Field>
                <Field>
                  <Name>List version ID</Name>
                  <Expr as="text">string(cbc:ItemClassificationCode/@listVersionID)</Expr>
                </Field>
                <Field>
                  <Name>Classification name</Name>
                  <Expr as="text">string(cbc:ItemClassificationCode/@name)</Expr>
                </Field>
              </Table>
              <Table foreach="cac:Item/cac:ClassifiedTaxCategory" title="Classified tax categories">
                <Field>
                  <Name>Tax category</Name>
                  <Expr>cbc:ID/text()</Expr>
                </Field>
                <Field>
                  <Name>Tax percent</Name>
                  <Expr>cbc:Percent/text()</Expr>
                </Field>
                <Field>
                  <Name>Tax scheme</Name>
                  <Expr>cac:TaxScheme/cbc:ID/text()</Expr>
                </Field>
              </Table>
              <Table foreach="cac:Item/cac:AdditionalItemProperty" headerPosition="horizontal">
                <Field>
                  <Name><Expr>cbc:Name/text()</Expr></Name>
                  <Expr>cbc:Value/text()</Expr>
                </Field>
              </Table>
            </Form>
