                <Field>
                  <Name>Seller item ID</Name>
                  <Expr>cac:SellersItemIdentification/cbc:ID/text()</Expr>
                </Field>
                <Field>
                  <Name>Standard item ID</Name>
                  <Expr>cac:StandardItemIdentification/cbc:ID/text()</Expr>
                </Field>
