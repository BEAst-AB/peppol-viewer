            <Expr>cac:Party/cac:PartyIdentification/cbc:ID/text()</Expr>
            <Expr>cac:Party/cac:PartyTaxScheme/cbc:CompanyID/text()</Expr>
            <Expr>cac:Party/cac:PostalAddress/cbc:StreetName/text()</Expr>
            <Expr>cac:Party/cac:PostalAddress/cbc:AdditionalStreetName/text()</Expr>
