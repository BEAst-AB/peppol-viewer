    <Section>
      <Fields>
        <Table foreach="/*:TransportExecutionPlan/cac:Consignment/cac:TransportHandlingUnit" title="Transport handling units" hasRowDetail="true">
          <Field>
            <Name>Handling unit ID</Name>
            <DisplayBlock format="singleLine">
              <Expr>cbc:ID/text()</Expr>
              <Expr as="text">string(cbc:ID/@schemeID)</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Type</Name>
            <Expr>cbc:TransportHandlingUnitTypeCode/text()</Expr>
          </Field>
          <Field>
            <Name>Goods</Name>
            <DisplayBlock>
              <Expr>cac:GoodsItem/cbc:Description/text()</Expr>
              <Expr>cac:GoodsItem/cbc:Quantity/text()</Expr>
              <Expr as="text">string(cac:GoodsItem/cbc:Quantity/@unitCode)</Expr>
              <Expr>cac:GoodsItem/cac:Item/cbc:Name/text()</Expr>
              <Expr>cac:GoodsItem/cac:Item/cac:CommodityClassification/cbc:ItemClassificationCode/text()</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Handling and shipping marks</Name>
            <DisplayBlock>
              <Expr>cbc:HandlingCode/text()</Expr>
              <Expr>cbc:HandlingInstructions/text()</Expr>
              <Expr>cbc:ShippingMarks/text()</Expr>
              <Expr>cbc:HazardousRiskIndicator/text()</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Transport equipment</Name>
            <DisplayBlock>
              <Expr>cac:TransportEquipment/cbc:ID/text()</Expr>
              <Expr>cac:TransportEquipment/cbc:TransportEquipmentTypeCode/text()</Expr>
              <Expr>cac:TransportEquipment/cbc:SizeTypeCode/text()</Expr>
              <Expr>cac:TransportEquipment/cbc:RefrigerationOnIndicator/text()</Expr>
              <Expr>cac:TransportEquipment/cbc:Description/text()</Expr>
              <Expr>cac:TransportEquipment/cbc:PowerIndicator/text()</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Measurements and temperatures</Name>
            <DisplayBlock>
              <Expr>cac:MeasurementDimension/cbc:AttributeID/text()</Expr>
              <Expr>cac:MeasurementDimension/cbc:Measure/text()</Expr>
              <Expr as="text">string(cac:MeasurementDimension/cbc:Measure/@unitCode)</Expr>
              <Expr>cac:MinimumTemperature/cbc:AttributeID/text()</Expr>
              <Expr>cac:MinimumTemperature/cbc:Measure/text()</Expr>
              <Expr as="text">string(cac:MinimumTemperature/cbc:Measure/@unitCode)</Expr>
              <Expr>cac:MaximumTemperature/cbc:AttributeID/text()</Expr>
              <Expr>cac:MaximumTemperature/cbc:Measure/text()</Expr>
              <Expr as="text">string(cac:MaximumTemperature/cbc:Measure/@unitCode)</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Hazardous item details</Name>
            <DisplayBlock>
              <Expr>cac:GoodsItem/cac:Item/cac:HazardousItem/cbc:ID/text()</Expr>
              <Expr>cac:GoodsItem/cac:Item/cac:HazardousItem/cbc:AdditionalInformation/text()</Expr>
              <Expr>cac:GoodsItem/cac:Item/cac:HazardousItem/cbc:UNDGCode/text()</Expr>
              <Expr>cac:GoodsItem/cac:Item/cac:HazardousItem/cbc:TechnicalName/text()</Expr>
              <Expr>cac:GoodsItem/cac:Item/cac:HazardousItem/cbc:CategoryName/text()</Expr>
              <Expr>cac:GoodsItem/cac:Item/cac:HazardousItem/cbc:HazardousCategoryCode/text()</Expr>
              <Expr>cac:GoodsItem/cac:Item/cac:HazardousItem/cbc:HazardClassID/text()</Expr>
              <Expr>cac:GoodsItem/cac:Item/cac:HazardousItem/cbc:NetWeightMeasure/text()</Expr>
              <Expr as="text">string(cac:GoodsItem/cac:Item/cac:HazardousItem/cbc:NetWeightMeasure/@unitCode)</Expr>
              <Expr>cac:GoodsItem/cac:Item/cac:HazardousItem/cbc:NetVolumeMeasure/text()</Expr>
              <Expr as="text">string(cac:GoodsItem/cac:Item/cac:HazardousItem/cbc:NetVolumeMeasure/@unitCode)</Expr>
              <Expr>cac:GoodsItem/cac:Item/cac:HazardousItem/cac:HazardousGoodsTransit/cbc:PackingCriteriaCode/text()</Expr>
              <Expr>cac:GoodsItem/cac:Item/cac:HazardousItem/cac:EmergencyTemperature/cbc:Measure/text()</Expr>
              <Expr as="text">string(cac:GoodsItem/cac:Item/cac:HazardousItem/cac:EmergencyTemperature/cbc:Measure/@unitCode)</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Shipment document reference</Name>
            <DisplayBlock format="singleLine">
              <Expr>cac:ShipmentDocumentReference/cbc:ID/text()</Expr>
              <Expr>cac:ShipmentDocumentReference/cbc:DocumentType/text()</Expr>
            </DisplayBlock>
          </Field>
        </Table>
      </Fields>
    </Section>
