<?xml version="1.0" encoding="utf-8"?>
<BusinessDocument xmlns="https://beast.se/xmltools">
  <Namespaces>
    <Namespace prefix="ubl">urn:oasis:names:specification:ubl:schema:xsd:OrderResponse-2</Namespace>
    <Namespace prefix="cac">urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2</Namespace>
    <Namespace prefix="cbc">urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2</Namespace>
  </Namespaces>
  <WindowTitle>Order Agreement</WindowTitle>
  <PageTitle>Order Agreement</PageTitle>
  <DocumentTitle>/*:OrderResponse/cbc:ID/text()</DocumentTitle>
  <TranslationXmlFile>dictionary.xml</TranslationXmlFile>
  <Section>
    <Fields>
      <Form title="Order agreement">
        <Field>
          <Name>Sales order</Name>
          <Expr>/*:OrderResponse/cbc:SalesOrderID/text()</Expr>
        </Field>
        <Field>
          <Name>Customer reference</Name>
          <Expr>/*:OrderResponse/cbc:CustomerReference/text()</Expr>
        </Field>
        <Field>
          <Name>Previous order agreement</Name>
          <Expr>/*:OrderResponse/cac:OrderReference/cbc:ID/text()</Expr>
        </Field>
        <Field>
          <Name>Tender or lot reference</Name>
          <Expr>/*:OrderResponse/cac:OriginatorDocumentReference/cbc:ID/text()</Expr>
        </Field>
        <Field>
          <Name>Contract</Name>
          <Expr>/*:OrderResponse/cac:Contract/cbc:ID/text()</Expr>
        </Field>
        <Field>
          <Name>Currency</Name>
          <Expr>/*:OrderResponse/cbc:DocumentCurrencyCode/text()</Expr>
        </Field>
      </Form>
      <Key>
        <Field>
          <Name>Issue date</Name>
          <Expr>/*:OrderResponse/cbc:IssueDate/text()</Expr>
        </Field>
        <Field>
          <Name>Issue time</Name>
          <Expr>/*:OrderResponse/cbc:IssueTime/text()</Expr>
        </Field>
        <Field>
          <Name>Promised delivery period</Name>
          <DisplayBlock>
            <Expr>/*:OrderResponse/cac:Delivery/cac:PromisedDeliveryPeriod/cbc:StartDate/text()</Expr>
            <Expr>/*:OrderResponse/cac:Delivery/cac:PromisedDeliveryPeriod/cbc:StartTime/text()</Expr>
            <Expr>/*:OrderResponse/cac:Delivery/cac:PromisedDeliveryPeriod/cbc:EndDate/text()</Expr>
            <Expr>/*:OrderResponse/cac:Delivery/cac:PromisedDeliveryPeriod/cbc:EndTime/text()</Expr>
          </DisplayBlock>
        </Field>
      </Key>
    </Fields>
    <Note>
      <Expr>/*:OrderResponse/cbc:Note/text()</Expr>
    </Note>
    <Reference>
      <Data>
        <Field forEach="/*:OrderResponse/cac:AdditionalDocumentReference">
          <Name>cbc:DocumentType/text()</Name>
          <Expr>cbc:ID/text()</Expr>
        </Field>
      </Data>
    </Reference>
    <Party>
      <Stakeholders>
        <Primary block="/*:OrderResponse/cac:SellerSupplierParty/cac:Party" title="Seller / Supplier">
          <DisplayBlock wrap="cellRow">
            <Expr format="bold">cac:Party/cac:PartyLegalEntity/cbc:RegistrationName/text()</Expr>
            <Expr>cac:Party/cbc:EndpointID/text()</Expr>
            <Expr>cac:Party/cac:PartyIdentification/cbc:ID/text()</Expr>
            <Expr>cac:Party/cac:PostalAddress/cbc:StreetName/text()</Expr>
            <Expr>cac:Party/cac:PostalAddress/cbc:AdditionalStreetName/text()</Expr>
            <DisplayBlock format="singleLine">
              <Expr>cac:Party/cac:PostalAddress/cbc:CityName/text()</Expr>
              <Expr>cac:Party/cac:PostalAddress/cac:Country/cbc:IdentificationCode/text()</Expr>
              <Expr>cac:Party/cac:PostalAddress/cbc:PostalZone/text()</Expr>
            </DisplayBlock>
          </DisplayBlock>
          <NewLine/>
          <DisplayBlock wrap="cellRow">
            <Expr>cac:Party/cac:Contact/cbc:Name/text()</Expr>
            <Expr>cac:Party/cac:Contact/cbc:Telephone/text()</Expr>
            <Expr>cac:Party/cac:Contact/cbc:ElectronicMail/text()</Expr>
          </DisplayBlock>
        </Primary>
        <Primary block="/*:OrderResponse/cac:BuyerCustomerParty" title="Buyer / Customer">
          <DisplayBlock wrap="cellRow">
            <Expr format="bold">cac:BuyerCustomerParty/cac:Party/cac:PartyLegalEntity/cbc:RegistrationName/text()</Expr>
            <Expr>cac:BuyerCustomerParty/cac:Party/cbc:EndpointID/text()</Expr>
            <Expr>cac:BuyerCustomerParty/cac:Party/cac:PartyIdentification/cbc:ID/text()</Expr>
            <Expr>cac:BuyerCustomerParty/cac:Party/cac:PostalAddress/cbc:StreetName/text()</Expr>
            <Expr>cac:BuyerCustomerParty/cac:Party/cac:PostalAddress/cbc:AdditionalStreetName/text()</Expr>
            <DisplayBlock format="singleLine">
              <Expr>cac:BuyerCustomerParty/cac:Party/cac:PostalAddress/cbc:CityName/text()</Expr>
              <Expr>cac:BuyerCustomerParty/cac:Party/cac:PostalAddress/cac:Country/cbc:IdentificationCode/text()</Expr>
              <Expr>cac:BuyerCustomerParty/cac:Party/cac:PostalAddress/cbc:PostalZone/text()</Expr>
            </DisplayBlock>
          </DisplayBlock>
          <NewLine/>
          <DisplayBlock wrap="cellRow">
            <Expr>cac:BuyerCustomerParty/cac:DeliveryContact/cbc:Name/text()</Expr>
            <Expr>cac:BuyerCustomerParty/cac:DeliveryContact/cbc:Telephone/text()</Expr>
            <Expr>cac:BuyerCustomerParty/cac:DeliveryContact/cbc:ElectronicMail/text()</Expr>
          </DisplayBlock>
        </Primary>
        <Secondary block="/*:OrderResponse/cac:OriginatorCustomerParty/cac:Party" title="Originator">
          <DisplayBlock wrap="cellRow">
            <Expr format="bold">cac:Party/cac:PartyName/cbc:Name/text()</Expr>
            <Expr>cac:Party/cac:PartyIdentification/cbc:ID/text()</Expr>
          </DisplayBlock>
        </Secondary>
        <Secondary block="/*:OrderResponse/cac:AccountingCustomerParty/cac:Party" title="Accounting customer">
          <DisplayBlock wrap="cellRow">
            <Expr format="bold">cac:Party/cac:PartyName/cbc:Name/text()</Expr>
            <Expr>cac:Party/cac:PartyIdentification/cbc:ID/text()</Expr>
          </DisplayBlock>
        </Secondary>
        <Secondary block="/*:OrderResponse/cac:Delivery/cac:DeliveryParty" title="Delivery party">
          <DisplayBlock wrap="cellRow">
            <Expr format="bold">cac:DeliveryParty/cac:PartyName/cbc:Name/text()</Expr>
            <Expr>cac:DeliveryParty/cac:PartyIdentification/cbc:ID/text()</Expr>
            <Expr>cac:DeliveryParty/cac:PostalAddress/cbc:StreetName/text()</Expr>
            <Expr>cac:DeliveryParty/cac:PostalAddress/cbc:AdditionalStreetName/text()</Expr>
            <DisplayBlock format="singleLine">
              <Expr>cac:DeliveryParty/cac:PostalAddress/cbc:CityName/text()</Expr>
              <Expr>cac:DeliveryParty/cac:PostalAddress/cac:Country/cbc:IdentificationCode/text()</Expr>
              <Expr>cac:DeliveryParty/cac:PostalAddress/cbc:PostalZone/text()</Expr>
            </DisplayBlock>
          </DisplayBlock>
        </Secondary>
        <Secondary block="/*:OrderResponse/cac:DeliveryTerms/cac:DeliveryLocation" title="Delivery location">
          <DisplayBlock wrap="cellRow">
            <Expr format="bold">cac:DeliveryLocation/cbc:ID/text()</Expr>
            <Expr>cac:DeliveryLocation/cac:Address/cbc:StreetName/text()</Expr>
            <Expr>cac:DeliveryLocation/cac:Address/cbc:AdditionalStreetName/text()</Expr>
            <DisplayBlock format="singleLine">
              <Expr>cac:DeliveryLocation/cac:Address/cbc:CityName/text()</Expr>
              <Expr>cac:DeliveryLocation/cac:Address/cac:Country/cbc:IdentificationCode/text()</Expr>
              <Expr>cac:DeliveryLocation/cac:Address/cbc:PostalZone/text()</Expr>
            </DisplayBlock>
          </DisplayBlock>
        </Secondary>
      </Stakeholders>
    </Party>
    <Section>
      <Fields>
        <Form title="Order totals">
          <Field>
            <Name>Line extension amount</Name>
            <DisplayBlock format="singleLine">
              <Expr>/*:OrderResponse/cac:LegalMonetaryTotal/cbc:LineExtensionAmount/text()</Expr>
              <Expr as="text">/*:OrderResponse/cac:LegalMonetaryTotal/cbc:LineExtensionAmount/@currencyID</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Tax exclusive amount</Name>
            <DisplayBlock format="singleLine">
              <Expr>/*:OrderResponse/cac:LegalMonetaryTotal/cbc:TaxExclusiveAmount/text()</Expr>
              <Expr as="text">/*:OrderResponse/cac:LegalMonetaryTotal/cbc:TaxExclusiveAmount/@currencyID</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Tax inclusive amount</Name>
            <DisplayBlock format="singleLine">
              <Expr>/*:OrderResponse/cac:LegalMonetaryTotal/cbc:TaxInclusiveAmount/text()</Expr>
              <Expr as="text">/*:OrderResponse/cac:LegalMonetaryTotal/cbc:TaxInclusiveAmount/@currencyID</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Allowance total</Name>
            <DisplayBlock format="singleLine">
              <Expr>/*:OrderResponse/cac:LegalMonetaryTotal/cbc:AllowanceTotalAmount/text()</Expr>
              <Expr as="text">/*:OrderResponse/cac:LegalMonetaryTotal/cbc:AllowanceTotalAmount/@currencyID</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Charge total</Name>
            <DisplayBlock format="singleLine">
              <Expr>/*:OrderResponse/cac:LegalMonetaryTotal/cbc:ChargeTotalAmount/text()</Expr>
              <Expr as="text">/*:OrderResponse/cac:LegalMonetaryTotal/cbc:ChargeTotalAmount/@currencyID</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Prepaid amount</Name>
            <DisplayBlock format="singleLine">
              <Expr>/*:OrderResponse/cac:LegalMonetaryTotal/cbc:PrepaidAmount/text()</Expr>
              <Expr as="text">/*:OrderResponse/cac:LegalMonetaryTotal/cbc:PrepaidAmount/@currencyID</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Payable amount</Name>
            <DisplayBlock format="singleLine">
              <Expr>/*:OrderResponse/cac:LegalMonetaryTotal/cbc:PayableAmount/text()</Expr>
              <Expr as="text">/*:OrderResponse/cac:LegalMonetaryTotal/cbc:PayableAmount/@currencyID</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Tax amount</Name>
            <DisplayBlock format="singleLine">
              <Expr>/*:OrderResponse/cac:TaxTotal/cbc:TaxAmount/text()</Expr>
              <Expr as="text">/*:OrderResponse/cac:TaxTotal/cbc:TaxAmount/@currencyID</Expr>
            </DisplayBlock>
          </Field>
        </Form>
        <Table foreach="/*:OrderResponse/cac:AllowanceCharge" title="Allowances and charges">
          <Field>
            <Name>Charge</Name>
            <Expr>cbc:ChargeIndicator/text()</Expr>
          </Field>
          <Field>
            <Name>Reason</Name>
            <Expr>cbc:AllowanceChargeReason/text()</Expr>
          </Field>
          <Field>
            <Name>Amount</Name>
            <DisplayBlock format="singleLine">
              <Expr>cbc:Amount/text()</Expr>
              <Expr as="text">cbc:Amount/@currencyID</Expr>
            </DisplayBlock>
          </Field>
        </Table>
        <Table foreach="/*:OrderResponse/cac:TaxTotal/cac:TaxSubtotal" title="Tax breakdown">
          <Field>
            <Name>Taxable amount</Name>
            <DisplayBlock format="singleLine">
              <Expr>cbc:TaxableAmount/text()</Expr>
              <Expr as="text">cbc:TaxableAmount/@currencyID</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Tax amount</Name>
            <DisplayBlock format="singleLine">
              <Expr>cbc:TaxAmount/text()</Expr>
              <Expr as="text">cbc:TaxAmount/@currencyID</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Tax category</Name>
            <Expr>cac:TaxCategory/cbc:ID/text()</Expr>
          </Field>
          <Field>
            <Name>Tax percent</Name>
            <Expr>cac:TaxCategory/cbc:Percent/text()</Expr>
          </Field>
          <Field>
            <Name>Tax exemption reason</Name>
            <Expr>cac:TaxCategory/cbc:TaxExemptionReason/text()</Expr>
          </Field>
          <Field>
            <Name>Tax scheme</Name>
            <Expr>cac:TaxCategory/cac:TaxScheme/cbc:ID/text()</Expr>
          </Field>
        </Table>
        <Table foreach="/*:OrderResponse/cac:OrderLine/cac:LineItem" title="Order lines" hasRowDetail="true">
          <Field>
            <Name>Line ID</Name>
            <Expr>cbc:ID/text()</Expr>
          </Field>
          <Field>
            <Name>Item</Name>
            <Expr>cac:Item/cbc:Name/text()</Expr>
          </Field>
          <Field>
            <Name>Quantity</Name>
            <DisplayBlock format="singleLine">
              <Expr>cbc:Quantity/text()</Expr>
              <Expr as="text">cbc:Quantity/@unitCode</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Line amount</Name>
            <DisplayBlock format="singleLine">
              <Expr>cbc:LineExtensionAmount/text()</Expr>
              <Expr as="text">cbc:LineExtensionAmount/@currencyID</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Price</Name>
            <DisplayBlock format="singleLine">
              <Expr>cac:Price/cbc:PriceAmount/text()</Expr>
              <Expr as="text">cac:Price/cbc:PriceAmount/@currencyID</Expr>
            </DisplayBlock>
          </Field>
          <Field>
            <Name>Details</Name>
            <DisplayBlock>
              <Expr>cbc:Note/text()</Expr>
              <Expr>cac:Delivery/cbc:Quantity/text()</Expr>
              <Expr>cac:Delivery/cac:PromisedDeliveryPeriod/cbc:StartDate/text()</Expr>
              <Expr>cac:Delivery/cac:PromisedDeliveryPeriod/cbc:StartTime/text()</Expr>
              <Expr>cac:Delivery/cac:PromisedDeliveryPeriod/cbc:EndDate/text()</Expr>
              <Expr>cac:Delivery/cac:PromisedDeliveryPeriod/cbc:EndTime/text()</Expr>
              <Expr>cac:Price/cbc:BaseQuantity/text()</Expr>
              <Expr>cac:Price/cbc:PriceType/text()</Expr>
              <Expr>cac:Price/cac:AllowanceCharge/cbc:Amount/text()</Expr>
              <Expr>cac:Price/cac:AllowanceCharge/cbc:BaseAmount/text()</Expr>
              <Expr>cac:Item/cbc:Description/text()</Expr>
              <Expr>cac:Item/cac:BuyersItemIdentification/cbc:ID/text()</Expr>
              <Expr>cac:Item/cac:SellersItemIdentification/cbc:ID/text()</Expr>
              <Expr>cac:Item/cac:StandardItemIdentification/cbc:ID/text()</Expr>
              <Expr>cac:Item/cac:CommodityClassification/cbc:ItemClassificationCode/text()</Expr>
              <Expr>cac:Item/cac:ClassifiedTaxCategory/cbc:ID/text()</Expr>
              <Expr>cac:Item/cac:ClassifiedTaxCategory/cbc:Percent/text()</Expr>
              <Expr>cac:Item/cac:ClassifiedTaxCategory/cac:TaxScheme/cbc:ID/text()</Expr>
            </DisplayBlock>
            <Table foreach="cac:Item/cac:AdditionalItemProperty" headerPosition="horizontal">
              <Field>
                <Name><Expr>cbc:Name/text()</Expr></Name>
                <Expr>cbc:Value/text()</Expr>
              </Field>
            </Table>
            <Table foreach="cac:Item/cac:Certificate" headerPosition="horizontal">
              <Field>
                <Name>Certificate</Name>
                <DisplayBlock format="singleLine">
                  <Expr>cbc:CertificateType/text()</Expr>
                  <Expr>cbc:ID/text()</Expr>
                  <Expr>cbc:Remarks/text()</Expr>
                </DisplayBlock>
              </Field>
            </Table>
            <Table foreach="cac:Item/cac:ItemSpecificationDocumentReference" headerPosition="horizontal">
              <Field>
                <Name>Item document</Name>
                <DisplayBlock format="singleLine">
                  <Expr>cbc:DocumentType/text()</Expr>
                  <Expr>cbc:ID/text()</Expr>
                  <Expr>cac:Attachment/cac:ExternalReference/cbc:URI/text()</Expr>
                </DisplayBlock>
              </Field>
            </Table>
          </Field>
        </Table>
      </Fields>
    </Section>
  </Section>
</BusinessDocument>
