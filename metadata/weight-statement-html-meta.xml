<?xml version="1.0" encoding="utf-8"?>
<BusinessDocument xmlns="https://beast.se/xmltools">
  <Namespaces>
    <Namespace prefix="ubl">urn:oasis:names:specification:ubl:schema:xsd:WeightStatement-2</Namespace>
    <Namespace prefix="cac">urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2</Namespace>
    <Namespace prefix="cbc">urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2</Namespace>
  </Namespaces>
  <WindowTitle>Weight Statement</WindowTitle>
  <PageTitle>Weight Statement</PageTitle>
  <DocumentTitle>/*:WeightStatement/cbc:ID/text()</DocumentTitle>
  <TranslationXmlFile>dictionary.xml</TranslationXmlFile>
  <Section>
    <Fields>
      <Form title="Weight statement">
        <Field>
          <Name>Type (01 = outbound, 02 = inbound)</Name>
          <Expr>/*:WeightStatement/cbc:WeightStatementTypeCode/text()</Expr>
        </Field>
        <Field>
          <Name>Shipment ID</Name>
          <DisplayBlock format="singleLine">
            <Expr>/*:WeightStatement/cac:Shipment/cbc:ID/text()</Expr>
            <Expr as="text">string(/*:WeightStatement/cac:Shipment/cbc:ID/@schemeID)</Expr>
          </DisplayBlock>
        </Field>
        <Field>
          <Name>Profile</Name>
          <Expr>/*:WeightStatement/cbc:ProfileID/text()</Expr>
        </Field>
      </Form>
      <Key>
        <Field>
          <Name>Issue date</Name>
          <Expr>/*:WeightStatement/cbc:IssueDate/text()</Expr>
        </Field>
        <Field>
          <Name>Issue time</Name>
          <Expr>/*:WeightStatement/cbc:IssueTime/text()</Expr>
        </Field>
      </Key>
    </Fields>
    <Party>
      <Stakeholders>
        <Primary block="/*:WeightStatement/cac:SenderParty" title="Sender">
          <DisplayBlock wrap="cellRow">
            <Expr format="bold">cac:SenderParty/cac:PartyName/cbc:Name/text()</Expr>
            <DisplayBlock format="singleLine">
              <Expr>cac:SenderParty/cbc:EndpointID/text()</Expr>
              <Expr as="text">string(cac:SenderParty/cbc:EndpointID/@schemeID)</Expr>
            </DisplayBlock>
            <DisplayBlock format="singleLine">
              <Expr>cac:SenderParty/cac:PartyIdentification/cbc:ID/text()</Expr>
              <Expr as="text">string(cac:SenderParty/cac:PartyIdentification/cbc:ID/@schemeID)</Expr>
            </DisplayBlock>
            <Expr>cac:SenderParty/cac:PostalAddress/cbc:StreetName/text()</Expr>
            <Expr>cac:SenderParty/cac:PostalAddress/cbc:AdditionalStreetName/text()</Expr>
            <Expr>cac:SenderParty/cac:PostalAddress/cac:AddressLine/cbc:Line/text()</Expr>
            <DisplayBlock format="singleLine">
              <Expr>cac:SenderParty/cac:PostalAddress/cbc:CityName/text()</Expr>
              <Expr>cac:SenderParty/cac:PostalAddress/cbc:PostalZone/text()</Expr>
              <Expr>cac:SenderParty/cac:PostalAddress/cac:Country/cbc:IdentificationCode/text()</Expr>
            </DisplayBlock>
          </DisplayBlock>
          <NewLine/>
          <DisplayBlock wrap="cellRow">
            <Expr>cac:SenderParty/cac:Contact/cbc:Name/text()</Expr>
            <Expr>cac:SenderParty/cac:Contact/cbc:Telephone/text()</Expr>
            <Expr>cac:SenderParty/cac:Contact/cbc:ElectronicMail/text()</Expr>
          </DisplayBlock>
        </Primary>
        <Primary block="/*:WeightStatement/cac:ReceiverParty" title="Receiver">
          <DisplayBlock wrap="cellRow">
            <Expr format="bold">cac:ReceiverParty/cac:PartyName/cbc:Name/text()</Expr>
            <DisplayBlock format="singleLine">
              <Expr>cac:ReceiverParty/cbc:EndpointID/text()</Expr>
              <Expr as="text">string(cac:ReceiverParty/cbc:EndpointID/@schemeID)</Expr>
            </DisplayBlock>
            <DisplayBlock format="singleLine">
              <Expr>cac:ReceiverParty/cac:PartyIdentification/cbc:ID/text()</Expr>
              <Expr as="text">string(cac:ReceiverParty/cac:PartyIdentification/cbc:ID/@schemeID)</Expr>
            </DisplayBlock>
            <Expr>cac:ReceiverParty/cac:PostalAddress/cbc:StreetName/text()</Expr>
            <Expr>cac:ReceiverParty/cac:PostalAddress/cbc:AdditionalStreetName/text()</Expr>
            <Expr>cac:ReceiverParty/cac:PostalAddress/cac:AddressLine/cbc:Line/text()</Expr>
            <DisplayBlock format="singleLine">
              <Expr>cac:ReceiverParty/cac:PostalAddress/cbc:CityName/text()</Expr>
              <Expr>cac:ReceiverParty/cac:PostalAddress/cbc:PostalZone/text()</Expr>
              <Expr>cac:ReceiverParty/cac:PostalAddress/cac:Country/cbc:IdentificationCode/text()</Expr>
            </DisplayBlock>
          </DisplayBlock>
          <NewLine/>
          <DisplayBlock wrap="cellRow">
            <Expr>cac:ReceiverParty/cac:Contact/cbc:Name/text()</Expr>
            <Expr>cac:ReceiverParty/cac:Contact/cbc:Telephone/text()</Expr>
            <Expr>cac:ReceiverParty/cac:Contact/cbc:ElectronicMail/text()</Expr>
          </DisplayBlock>
        </Primary>
        <Secondary block="/*:WeightStatement/cac:WeighingParty" title="Weighing party">
          <DisplayBlock wrap="cellRow">
            <Expr format="bold">cac:WeighingParty/cac:PartyName/cbc:Name/text()</Expr>
            <DisplayBlock format="singleLine">
              <Expr>cac:WeighingParty/cac:PartyIdentification/cbc:ID/text()</Expr>
              <Expr as="text">string(cac:WeighingParty/cac:PartyIdentification/cbc:ID/@schemeID)</Expr>
            </DisplayBlock>
            <Expr>cac:WeighingParty/cac:PhysicalLocation/cbc:Name/text()</Expr>
            <DisplayBlock format="singleLine">
              <Expr>cac:WeighingParty/cac:PhysicalLocation/cbc:ID/text()</Expr>
              <Expr as="text">string(cac:WeighingParty/cac:PhysicalLocation/cbc:ID/@schemeID)</Expr>
            </DisplayBlock>
            <Expr>cac:WeighingParty/cac:PostalAddress/cbc:StreetName/text()</Expr>
            <Expr>cac:WeighingParty/cac:PostalAddress/cbc:AdditionalStreetName/text()</Expr>
            <Expr>cac:WeighingParty/cac:PostalAddress/cac:AddressLine/cbc:Line/text()</Expr>
            <DisplayBlock format="singleLine">
              <Expr>cac:WeighingParty/cac:PostalAddress/cbc:CityName/text()</Expr>
              <Expr>cac:WeighingParty/cac:PostalAddress/cbc:PostalZone/text()</Expr>
              <Expr>cac:WeighingParty/cac:PostalAddress/cac:Country/cbc:IdentificationCode/text()</Expr>
            </DisplayBlock>
          </DisplayBlock>
          <NewLine/>
          <DisplayBlock wrap="cellRow">
            <Expr>cac:WeighingParty/cac:Contact/cbc:Name/text()</Expr>
            <Expr>cac:WeighingParty/cac:Contact/cbc:Telephone/text()</Expr>
            <Expr>cac:WeighingParty/cac:Contact/cbc:ElectronicMail/text()</Expr>
          </DisplayBlock>
        </Secondary>
        <Secondary block="/*:WeightStatement/cac:ShipperParty" title="Shipper">
          <DisplayBlock wrap="cellRow">
            <Expr format="bold">cac:ShipperParty/cac:PartyName/cbc:Name/text()</Expr>
            <DisplayBlock format="singleLine">
              <Expr>cac:ShipperParty/cac:PartyIdentification/cbc:ID/text()</Expr>
              <Expr as="text">string(cac:ShipperParty/cac:PartyIdentification/cbc:ID/@schemeID)</Expr>
            </DisplayBlock>
            <Expr>cac:ShipperParty/cac:PostalAddress/cbc:StreetName/text()</Expr>
            <Expr>cac:ShipperParty/cac:PostalAddress/cbc:AdditionalStreetName/text()</Expr>
            <Expr>cac:ShipperParty/cac:PostalAddress/cac:AddressLine/cbc:Line/text()</Expr>
            <DisplayBlock format="singleLine">
              <Expr>cac:ShipperParty/cac:PostalAddress/cbc:CityName/text()</Expr>
              <Expr>cac:ShipperParty/cac:PostalAddress/cbc:PostalZone/text()</Expr>
              <Expr>cac:ShipperParty/cac:PostalAddress/cac:Country/cbc:IdentificationCode/text()</Expr>
            </DisplayBlock>
          </DisplayBlock>
          <NewLine/>
          <DisplayBlock wrap="cellRow">
            <Expr>cac:ShipperParty/cac:Contact/cbc:Name/text()</Expr>
            <Expr>cac:ShipperParty/cac:Contact/cbc:Telephone/text()</Expr>
            <Expr>cac:ShipperParty/cac:Contact/cbc:ElectronicMail/text()</Expr>
          </DisplayBlock>
        </Secondary>
      </Stakeholders>
    </Party>
    <Section>
      <Fields>
        <Table foreach="/*:WeightStatement/cac:Shipment/cac:GoodsItem" title="Goods items" hasRowDetail="true">
          <Field>
            <Name>Line ID</Name>
            <Expr>cbc:ID/text()</Expr>
          </Field>
          <Field>
            <Name>Item</Name>
            <Expr>cac:Item/cbc:Name/text()</Expr>
          </Field>
          <Field>
            <Name>Buyer item ID</Name>
            <Expr>cac:Item/cac:BuyersItemIdentification/cbc:ID/text()</Expr>
          </Field>
          <Field>
            <Name>Seller item ID</Name>
            <Expr>cac:Item/cac:SellersItemIdentification/cbc:ID/text()</Expr>
          </Field>
          <Field>
            <Name>Measurement</Name>
            <Table foreach="cac:MeasurementDimension" headerPosition="horizontal">
              <Field>
                <Name>Attribute</Name>
                <Expr>cbc:AttributeID/text()</Expr>
              </Field>
              <Field>
                <Name>Measure</Name>
                <DisplayBlock format="singleLine">
                  <Expr>cbc:Measure/text()</Expr>
                  <Expr as="text">string(cbc:Measure/@unitCode)</Expr>
                </DisplayBlock>
              </Field>
            </Table>
          </Field>
          <Field>
            <Name>Item details</Name>
            <DisplayBlock>
              <Expr>cac:Item/cac:StandardItemIdentification/cbc:ID/text()</Expr>
              <Expr as="text">string(cac:Item/cac:StandardItemIdentification/cbc:ID/@schemeID)</Expr>
              <Expr>cac:Item/cac:CommodityClassification/cbc:ItemClassificationCode/text()</Expr>
              <Expr as="text">string(cac:Item/cac:CommodityClassification/cbc:ItemClassificationCode/@listID)</Expr>
              <Expr as="text">string(cac:Item/cac:CommodityClassification/cbc:ItemClassificationCode/@listVersionID)</Expr>
              <Expr as="text">string(cac:Item/cac:CommodityClassification/cbc:ItemClassificationCode/@name)</Expr>
            </DisplayBlock>
          </Field>
        </Table>
      </Fields>
    </Section>
  </Section>
</BusinessDocument>
